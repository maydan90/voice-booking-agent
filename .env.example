# LiveKit (only needed for `python -m agent.main dev` / `start`; `console` runs locally)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Providers for the voice pipeline
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
# Optional: one .jsonl per call with every tool outcome (request id, code, effect, latency, the sentence said)
TRANSCRIPTS_DIR=transcripts
